<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CalculateurAge.MainPage"
             Title="Calculateur">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label Text="Nom" FontSize="16"/>
            <Entry Text="{Binding Nom, Mode=TwoWay}"
                   Placeholder="Votre nom"/>
            <Label Text="Date de naissance" FontSize="16"/>
            <DatePicker Date="{Binding DateNaissance}"/>

            <Label Text="{Binding Erreur}" TextColor="Red"/>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Grid.Column="0" Text="Calculer"
                        Command="{Binding CalculerCommand}"/>
                <Button Grid.Column="1" Text="Effacer"
                        Command="{Binding EffacerCommand}"/>
            </Grid>

            <VerticalStackLayout IsVisible="{Binding ResultatVisible}" Spacing="8">
                <Label Text="{Binding Resultat}" FontSize="20"/>
                <Label Text="{Binding Statut}" FontAttributes="Bold"/>
                <Label Text="{Binding ProchainAnniversaire}"/>
                <Button Text="Voir le détail"
                        Command="{Binding VoirDetailCommand}"/>
            </VerticalStackLayout>

            <Label Text="Historique" FontSize="16" FontAttributes="Bold" Margin="0,12,0,0"/>
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Historique}" Spacing="4">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Label Text="{Binding .}"/>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
