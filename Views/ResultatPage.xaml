<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CalculateurAge.Views.ResultatPage"
             Title="Résultat">
    <VerticalStackLayout Padding="20" Spacing="16">
        <Label Text="{Binding Resultat}" FontSize="20"/>
        <Label Text="{Binding Statut}" FontAttributes="Bold"/>
        <Label Text="{Binding ProchainAnniversaire}"/>
        <Button Text="Retour" Command="{Binding RetourCommand}"/>
    </VerticalStackLayout>
</ContentPage>
